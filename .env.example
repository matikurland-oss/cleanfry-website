# דוגמה למשתני סביבה — ללא ערכים אמיתיים. העתיקו ל-.env.local לפיתוח מקומי,
# והגדירו את אותם משתנים ב-Vercel (Project Settings → Environment Variables).
# אסור לשים סודות במשתני VITE_* — הם נכנסים לקוד שנשלח לדפדפן.

# --- צד שרת בלבד ---
# Supabase: Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# חתימת ההפניה להזמנה שנשלחת לטרנזילה (מחרוזת אקראית ארוכה, למשל: openssl rand -base64 48)
ORDER_SIGNING_SECRET=

# Vercel Cron שולח את הערך הזה בכותרת Authorization ל-/api/cron/reconcile
CRON_SECRET=

# טרנזילה — מפתחות API לאימות עסקאות (ממשק הניהול של טרנזילה / תמיכה). בלעדיהם תשלומים
# נשמרים כ"ממתינים לאימות" ולא נספרים בדוחות.
TRANZILA_APP_KEY=
TRANZILA_SECRET=
TRANZILA_TERMINAL=cleanfry
# אופציונלי: כתובת חיפוש העסקאות, אם טרנזילה מספקת כתובת שונה מברירת המחדל
# TRANZILA_TRANSACTIONS_SEARCH_URL=https://api.tranzila.com/v1/transactions

# נדרש רק לכלי הייבוא החד-פעמי (scripts/import-coupons.ts)
EDGE_CONFIG=

# --- דפדפן (ציבורי בכוונה; RLS חוסם כל גישה ישירה לטבלאות) ---
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=
# מזהה פרויקט ב-Microsoft Clarity (הקלטות סשן ומפות חום). ריק = Clarity לא נטען.
VITE_CLARITY_PROJECT_ID=
